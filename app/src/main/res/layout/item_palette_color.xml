<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="64dp"
    android:layout_height="72dp"
    android:layout_marginStart="4dp"
    android:layout_marginEnd="4dp"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- Selection Outer Ring -->
    <View
        android:id="@+id/selectionRing"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="center_horizontal|top"
        android:layout_marginTop="2dp"
        android:background="@drawable/bg_palette_selected"
        android:visibility="gone" />

    <!-- Color Circle Background -->
    <View
        android:id="@+id/colorCircle"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="center_horizontal|top"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_palette_normal" />

    <!-- Color Number Text -->
    <TextView
        android:id="@+id/tvColorNumber"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal|top"
        android:layout_marginTop="18dp"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold"
        android:text="1" />

    <!-- Checkmark Icon (when color is completed) -->
    <ImageView
        android:id="@+id/ivCheckmark"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_gravity="center_horizontal|top"
        android:layout_marginTop="18dp"
        android:src="@drawable/ic_check"
        android:visibility="gone" />

    <!-- Remaining Pieces Count Badge -->
    <TextView
        android:id="@+id/tvRemainingCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal|bottom"
        android:layout_marginBottom="2dp"
        android:textColor="@color/text_muted"
        android:textSize="11sp"
        android:text="12 left" />

</FrameLayout>
