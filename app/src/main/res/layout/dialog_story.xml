<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="24dp"
    app:cardCornerRadius="20dp"
    app:cardElevation="10dp"
    app:cardBackgroundColor="@color/story_parchment"
    app:strokeColor="@color/story_border"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center_horizontal">

        <!-- Chapter Label -->
        <TextView
            android:id="@+id/tvStoryChapter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/primary"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.1"
            android:textAllCaps="true"
            tools:text="CHAPTER 1" />

        <!-- Title -->
        <TextView
            android:id="@+id/tvStoryTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/text_main"
            android:textSize="20sp"
            android:textStyle="bold"
            tools:text="The Village Bakery" />

        <!-- Divider -->
        <View
            android:layout_width="60dp"
            android:layout_height="2dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="16dp"
            android:background="@color/primary" />

        <!-- Story Narrative Body -->
        <TextView
            android:id="@+id/tvStoryBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_main"
            android:textSize="15sp"
            android:lineSpacingExtra="4dp"
            android:gravity="center"
            tools:text="In the quiet heart of the old kingdom, the warmth of the baker's hearth brings life to the cobblestone streets..." />

        <!-- Action Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnStoryAction"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="24dp"
            android:text="@string/continue_story"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            app:cornerRadius="26dp"
            app:backgroundTint="@color/primary" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
